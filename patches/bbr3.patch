 };
 
 /* Window length of min_rtt filter (in sec): */
@@ -960,6 +960,25 @@
 		    bbr->cycle_idx == BBR_BW_PROBE_UP)
 			bbr->cwnd_gain +=
 				BBR_UNIT * bbr_param(sk, bw_probe_cwnd_gain) / 4;
+
+		// overwrite pacing gain in case of scheduling effects
+		struct tcp_sock *tp = tcp_sk(sk);
+		if (tp->rate_app_limited)
+			return;
+
+		u32 cap = bbr_bdp(sk, bbr_bw(sk), BBR_UNIT*84/100);
+		u32 expected_inflight = min(cap, bbr->inflight_lo);
+		if (bbr->smoothed_inflight == 0)
+		{
+			bbr->smoothed_inflight = (tp->bytes_sent - tp->bytes_acked)/tp->mss_cache;
+		} else {
+			bbr->smoothed_inflight = bbr->smoothed_inflight - (bbr->smoothed_inflight >> 2) + (((tp->bytes_sent - tp->bytes_acked)/tp->mss_cache) >> 2);
+		}
+
+		u32 current_rtt_us = tp->srtt_us >> 3;
+		if (bbr->smoothed_inflight < expected_inflight && (!bbr->probe_rtt_done_stamp || after(tcp_jiffies32, bbr->probe_rtt_done_stamp + 3*usecs_to_jiffies(current_rtt_us)))) {
+			bbr->pacing_gain = bbr_param(sk, startup_pacing_gain);
+		}
 		break;
